# Local development only. Never commit a filled-in copy of this file;
# in CI these values live in GitHub encrypted secrets.

# Mode: dry-run (default, sends nothing) | staging | production
VCA_MODE=dry-run

# --- Gmail OAuth 2.0 (scopes: gmail.send + gmail.metadata) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# --- Pushover ---
PUSHOVER_TOKEN=
PUSHOVER_USER=

# --- Staging only: the single approved test destination ---
STAGING_RECIPIENT=

# --- Direct-email path only (not used by the live GitHub-only alerting) ---
# Comma-separated. Never commit real addresses; this repository is public.
VCA_EMAIL_RECIPIENTS=
